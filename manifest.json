{
  "manifest_version": 3,
  "name": "Simple Color Change Extension",
  "version": "1.0.0",
  "description": "A simple Chrome extension that changes its icon color when clicked.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "action": {
    "default_icon": {
      "16": "icons/icon-green-16.png",
      "48": "icons/icon-green-48.png",
      "128": "icons/icon-green-128.png"
    },
    "default_title": "Click to toggle icon color"
  },
  "icons": {
    "16": "icons/icon-green-16.png",
    "48": "icons/icon-green-48.png",
    "128": "icons/icon-green-128.png"
  }
}
